# Rul v0.6 Exit Program 3: Buffer-Level wc + grep
# Linked with stdlib/string.rls via `rul link`.
# Reads pattern on line 1 followed by text buffer; computes exact lines/words/bytes (wc)
# plus matched line count and 63-bit FNV-1a matched-line digest using str::find_substr
# under a live RegionLease(std.io.in).
cap 0x8
export region std.io.in 0
export region std.io.out 1
import func str::find_substr 0
import func str::fmt_i64 1
export func wcgrep::main 3
data seg 0 hex ""
data seg 1 "lines= words= bytes= matches= digest=\n"
proof 3 rule=const_data_in_bounds target=0 lo=0 hi=256 witness=0
proof 4 rule=region_decl target=0 lo=0 hi=134217728 witness=u8:input
