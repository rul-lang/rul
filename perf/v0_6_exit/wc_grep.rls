proof 7 rule=func_sig target=1 lo=1 hi=i64 witness=i64
proof 8 rule=func_sig target=2 lo=2 hi=i64,i64 witness=void
proof 9 rule=func_sig target=3 lo=0 hi=0 witness=i64
