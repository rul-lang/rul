# Rul v0.6 Standard Library: Open-Addressing Power-of-Two Byte-Keyed I64 HashMap
# 64-bit FNV-1a hashing, tombstone deletion, compacted key arena, and zero-copy RegionDrop/RegionMove rehash.
# Layout (32M max slots = 23.48M live keys @ 0.7 load, 128 MiB compacted key arena):
#   map.meta (slot 1, i64:plain, 8 slots): [0]=cap, [1]=mask, [2]=live_count,
#     [3]=used_count, [4]=key_bytes_used, [5]=last_found, [6]=live_key_bytes, [7]=reserved
#   map.kmeta (slot 2, i64:plain): packed (state<<60)|(koff<<30)|klen (0=Empty,1=Occ,2=Tomb; 30-bit koff/klen)
#   map.hash (slot 3, i64:plain): 64-bit FNV-1a key hash
#   map.val (slot 4, i64:plain): stored I64 value
#   map.keys (slot 5, u8:plain): key byte arena (compacted down to live keys on rehash)
#   map.{kmeta,hash,val,keys}_scratch (slots 6..9): zero-copy rehash destinations swapped via RegionMove
# Read-only input key spans use FuncRegionEffect (std.io.in: Leased -> Leased).
cap 0x0
import region std.io.in 0
export region map.meta 1
export region map.kmeta 2
export region map.hash 3
export region map.val 4
export region map.keys 5
export region map.kmeta_scratch 6
export region map.hash_scratch 7
export region map.val_scratch 8
export region map.keys_scratch 9
export func map::init 1
export func map::set_span 2
export func map::get_span 3
export func map::del_span 4
export func map::count 5
export func map::last_found 6
